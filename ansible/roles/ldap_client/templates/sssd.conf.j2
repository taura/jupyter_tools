[sssd]
services = nss, pam
domains = default

[nss]
filter_groups = root
filter_users = root

[domain/default]
id_provider = ldap
# Connect by the certificate's name (fqdn); an IP address fails verification.
# /etc/hosts (roles/basics) resolves the fqdn to the internal address.
ldap_uri = ldap://{{ ldap_server_name }}/
ldap_search_base = {{ ldap_domain }}

# sssd requires encryption for password auth; slapd has StartTLS with the
# roles/cert certificate (roles/ldap_server). True is the 2.12 default; be explicit.
ldap_id_use_start_tls = True
ldap_tls_reqcert = demand
ldap_tls_cacert = /etc/ssl/certs/ca-certificates.crt

# 匿名 read が許可されているので bind 不要。
# ldap_default_bind_dn を書かずに ldap_default_authtok だけ置いても使われず、
# ドメインのパスワードがこのファイルに残るだけなので書かない。

