# JupyterHub environment (systemd EnvironmentFile), from vars/jupyterhub.yml.
# Managed by ansible (roles/jupyterhub). KEY=value only; no "export".
FQDN={{ fqdn }}
GOOGLE_CLIENT_ID={{ jupyterhub_google_client_id }}
GOOGLE_CLIENT_SECRET={{ jupyterhub_google_client_secret }}
GOOGLE_DOMAIN={{ jupyterhub_google_domain }}
SINGLEUSER_VENV={{ jupyterhub_singleuser_venv }}
{% for k, v in jupyterhub_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
