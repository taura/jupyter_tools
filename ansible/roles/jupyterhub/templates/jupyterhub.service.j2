# JupyterHub (systemd system service)
# managed by ansible (roles/jupyterhub)。このファイルは template。
#
#   sudo systemctl status  jupyterhub
#   sudo systemctl restart jupyterhub
#   journalctl -u jupyterhub -f
#
# hub は root で動く (LocalProcessSpawner が学生の uid に切り替えて
# サーバを起動するため)。root が実行するものはすべて root 所有にしてある:
#   {{ jupyterhub_dir }}/venv                  hub 本体の venv (../hub/pyproject.toml)
#   {{ jupyterhub_dir }}/jupyterhub_config.py  設定 (../hub/jupyterhub_config.py)
#   /etc/jupyterhub/jupyterhub.env    秘密情報 (vars/jupyterhub.yml から)
#   {{ jupyterhub_state_dir }}              jupyterhub.sqlite, cookie secret, user_map.sqlite
# 学生のサーバは share 所有の {{ jupyterhub_singleuser_venv }} で動く。
#
# ログは journal に入る。ローテーションも journald が面倒を見る。

[Unit]
Description=JupyterHub
After=network-online.target sssd.service
Wants=network-online.target
# 学生のホームと、学生のサーバの venv ({{ jupyterhub_singleuser_venv }}) は
# 別ディスクの /home にあるのでマウントを待つ
RequiresMountsFor=/home

[Service]
Type=simple
User=root
WorkingDirectory={{ jupyterhub_state_dir }}
EnvironmentFile=/etc/jupyterhub/jupyterhub.env
ExecStart={{ jupyterhub_dir }}/venv/bin/jupyterhub -f {{ jupyterhub_dir }}/jupyterhub_config.py

# configurable-http-proxy は npm で入れた /usr/local/bin にある (apt 版は壊れている)
Environment=PATH={{ jupyterhub_dir }}/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

Restart=on-failure
RestartSec=5

# KillMode は既定 (control-group) のまま。停止時に単一ユーザサーバも止まる。
# c.JupyterHub.cleanup_servers が既定 True なので hub 自身がまず片付け、
# 取りこぼしを systemd が回収する。Spawner の設定変更 (env_keep など) は
# 新規 spawn からしか効かないので、確実に反映するにはこれでよい。
# 逆に「hub だけ再起動して学生の作業を続けさせたい」場合は
# cleanup_servers = False + KillMode=process にする。
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
