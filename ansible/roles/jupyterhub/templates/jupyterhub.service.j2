# JupyterHub (systemd system service)
# Installed by ansible (roles/jupyterhub). This is a template.
#
#   sudo systemctl status  jupyterhub
#   sudo systemctl restart jupyterhub       # after git pull / uv sync in hub/
#   journalctl -u jupyterhub -f
#
# Runs as root (LocalProcessSpawner switches to each student's uid), straight
# from the checkout {{ jupyterhub_repo }}/hub:
#   .venv/                 hub venv (uv sync)
#   jupyterhub_config.py   config
#   jupyterhub.env         secrets (not committed)
#   state/                 working directory ({{ jupyterhub_state_owner }}-owned): jupyterhub.sqlite, cookie secret, user_map.sqlite
#
# Logs go to the journal.

[Unit]
Description=JupyterHub
After=network-online.target sssd.service
Wants=network-online.target
# The checkout and students' homes are on the separate /home disk
RequiresMountsFor=/home

[Service]
Type=simple
User=root
WorkingDirectory={{ jupyterhub_repo }}/hub/state
# state/ is owned by {{ jupyterhub_state_owner }} so user_map.py can be run without sudo.
# Files the hub creates there (jupyterhub.sqlite, the 0600 cookie secret) stay root-owned.
ExecStartPre=/usr/bin/install -d -m 0700 -o {{ jupyterhub_state_owner }} -g {{ jupyterhub_state_owner }} {{ jupyterhub_repo }}/hub/state
EnvironmentFile={{ jupyterhub_repo }}/hub/jupyterhub.env
ExecStart={{ jupyterhub_repo }}/hub/.venv/bin/jupyterhub -f {{ jupyterhub_repo }}/hub/jupyterhub_config.py

# configurable-http-proxy is in /usr/local/bin (npm; the apt package is broken)
Environment=PATH={{ jupyterhub_repo }}/hub/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

Restart=on-failure
RestartSec=5

# KillMode は既定 (control-group) のまま。停止時に単一ユーザサーバも止まる。
# c.JupyterHub.cleanup_servers が既定 True なので hub 自身がまず片付け、
# 取りこぼしを systemd が回収する。Spawner の設定変更 (env_keep など) は
# 新規 spawn からしか効かないので、確実に反映するにはこれでよい。
# 逆に「hub だけ再起動して学生の作業を続けさせたい」場合は
# cleanup_servers = False + KillMode=process にする。
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
