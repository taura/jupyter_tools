# Settings for ./opencode_setup. Copy to opencode_setup.env (chmod 600); not committed.
# Needed only when keys have to be issued (rows with an empty litellm_key).

# LiteLLM admin key that can create teams and keys (see README.md)
LITELLM_API_KEY=sk-...

# Admin API base URL; --litellm-server overrides it
#LITELLM_URL=http://127.0.0.1:4000

# Optional per-key limits
#LITELLM_KEY_DURATION=180d
#LITELLM_KEY_MAX_BUDGET=20
