# OpenCode (および OpenAI SDK 互換のハーネス) から LiteLLM を使うための設定
# cp client.env.example client.env && chmod 600 client.env  してから埋める。
# client.env はコミットしない (.gitignore 済み)。
#
# 学生に渡すのはこの 2 つだけ。プロバイダ (Azure, mdx MaaS) のキーは
# クライアントに置かない。すべて LiteLLM が代理で持つ。

# 末尾の /v1 まで含める。Apache は /litellm/v1/ だけを LiteLLM に転送する。
export LITELLM_BASE_URL=https://taulec.zapto.org/litellm/v1

# LiteLLM の /key/generate で発行した virtual key
export LITELLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# aider など OpenAI SDK 互換のツールはこちらの名前を見る
export OPENAI_API_BASE="$LITELLM_BASE_URL"
export OPENAI_API_KEY="$LITELLM_API_KEY"
