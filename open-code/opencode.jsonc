// OpenCode -> LiteLLM
//
// Install as ~/.config/opencode/opencode.jsonc (opencode_setup does this).
// No key here: opencode takes it from ~/.local/share/opencode/auth.json, entry "litellm"
// (written by opencode_setup, or by "opencode auth login" -> Other -> litellm).
//
// models のキーは LiteLLM の config.yaml の model_name と完全一致させること。
// 片方だけ変えると OpenCode 側から見えなくなる。
// name は表示用のラベルなので自由。
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (taulec)",
      "options": {
        "baseURL": "https://taulec.zapto.org/litellm/v1"
      },
      "models": {
        "gpt-5.6-luna-utokyo-azure":  { "name": "GPT-5.6 Luna (UTokyo Azure)" },
        "gpt-5.3-codex-utokyo-azure": { "name": "GPT-5.3 Codex (UTokyo Azure)" },
        "gpt-oss-20b-mdx-maas":       { "name": "gpt-oss-20b (mdx MaaS)" }
      }
    }
  },
  "model": "litellm/gpt-5.3-codex-utokyo-azure"
}
