// OpenCode -> LiteLLM
//
// ~/.config/opencode/opencode.jsonc へ symlink して使う (./install が行う)。
//
// models のキーは LiteLLM の config.yaml の model_name と完全一致させること。
// 片方だけ変えると OpenCode 側から見えなくなる。
// name は表示用のラベルなので自由。
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (taulec)",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna-utokyo-azure":  { "name": "GPT-5.6 Luna (UTokyo Azure)" },
        "gpt-5.3-codex-utokyo-azure": { "name": "GPT-5.3 Codex (UTokyo Azure)" },
        "gpt-oss-20b-mdx-maas":       { "name": "gpt-oss-20b (mdx MaaS)" }
      }
    }
  },
  "model": "litellm/gpt-5.3-codex-utokyo-azure"
}
