# Open WebUI のホスト固有設定と秘密情報
# cp oauth.env.example oauth.env && chmod 600 oauth.env  してから埋める。
# oauth.env はコミットしない (.gitignore 済み)。

# --- Google Cloud Console > APIs & Services > 認証情報 >
#     OAuth 2.0 クライアント ID (ウェブアプリケーション) ---
export GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
export GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 公開ホストの場合 (Apache が 3000 で TLS 終端し 8080 に中継する構成) ---
# 手元での検証だけなら 3 行とも不要。
#export BASE_URL=https://example.org:3000
#export BIND_HOST=127.0.0.1
#export BIND_PORT=8080

# 名簿 (../enroll で事前登録) にない g.ecc ユーザのサインアップを許すか (既定: false)。
# true にすると pending (承認待ち) で作られる。最初の管理者は Google ログインで
# 作られるので、新しく立てたときは管理者がログインするまで true にしておく。
#export ENABLE_OAUTH_SIGNUP=false

# ログインを許可するメールドメイン (既定: g.ecc.u-tokyo.ac.jp)
#export ALLOWED_DOMAIN=g.ecc.u-tokyo.ac.jp

# DB と添付ファイルの置き場 (既定: ~/open-webui-data)
#export DATA_DIR=$HOME/open-webui-data
