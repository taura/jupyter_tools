#!/bin/bash
# Open WebUI をこのホストに設置する。冪等。
# No sudo; run as the (non-sudo) account that runs Open WebUI.
#
#   ./install            # 全部
#   ./install deps       # uv sync だけ
#   ./install service    # systemd user service の登録
#
# Root-only parts (linger, Apache TLS termination) are done by ansible roles/open_webui:
#   cd ../ansible && ansible-playbook -i machines.ini open_webui.yml
set -eu
cd "$(dirname "$0")"
HERE=$(pwd)

need_env() {
    if [ ! -f oauth.env ]; then
        echo "oauth.env がありません。" >&2
        echo "  cp oauth.env.example oauth.env && chmod 600 oauth.env" >&2
        echo "して値を埋めてから実行してください。" >&2
        exit 1
    fi
}

do_deps() {
    command -v uv >/dev/null || {
        echo "uv がありません: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2; exit 1; }
    uv sync
}

do_service() {
    need_env
    mkdir -p ~/.config/systemd/user
    ln -sfn "$HERE/open-webui.service" ~/.config/systemd/user/open-webui.service
    systemctl --user daemon-reload
    systemctl --user enable --now open-webui
    systemctl --user status open-webui --no-pager | head -5 || true
    if [ ! -e "/var/lib/systemd/linger/$USER" ]; then
        echo
        echo "linger が無効です。ログアウトすると止まり、ホスト起動時にも上がりません。"
        echo "ansible の roles/open_webui を流してください (open_webui_user: $USER)。"
    fi
}

case "${1:-all}" in
    deps)    do_deps ;;
    service) do_service ;;
    all)     do_deps; do_service ;;
    *)       echo "usage: $0 [all|deps|service]" >&2; exit 1 ;;
esac
