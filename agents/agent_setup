#!/usr/bin/env python3
"""
Set up coding agents (OpenCode, Codex CLI) -> LiteLLM for the users in a
roster on this server: one LiteLLM key per account, written into each
agent's credential file, plus each agent's shared config.

    # taulec: issue missing keys, write into homes as root, save the keys
    ./agent_setup --sudo --class pl -o roster_with_keys.csv roster.csv

    # another cluster (no root): keys already in the litellm_key column
    ./agent_setup --config /shared/agents/{user}/config --prefix /shared/agents/{user}/local \\
        --codex-home /shared/agents/{user}/codex sc_roster.csv

Roster columns (others are ignored and copied to the output as they are):
    user          account on this server (required)
    litellm_user  LiteLLM user_id owning a new key (may repeat); empty and no
                  litellm_key = the row is skipped
    litellm_key   the key; empty = issue one for litellm_user
    litellm_team  LiteLLM team alias for a new key; created if missing
    class         used by --class

For each selected row:
    key              use litellm_key, or issue one (key_alias = user, or
                     user@site with --site; aliases are unique in LiteLLM)
    opencode:
      oc_auth        {prefix}/share/opencode/auth.json: set the "litellm" entry
                     (other entries are kept)
      oc_config      {config}/opencode/opencode.jsonc <- --opencode-config
                     (copy, or symlink with --opencode-config-mode symlink)
    codex:
      codex_auth     {codex_home}/auth.json: {"auth_mode": "apikey", "OPENAI_API_KEY": key}
      codex_config   {codex_home}/config.toml <- --codex-config (always a copy:
                     Codex writes to it, e.g. trusted directories)

Config files and Codex's auth.json are never overwritten: an existing file
that differs is reported and left alone (Codex's auth.json holds one login,
e.g. a ChatGPT one). --force-opencode-jsonc replaces a differing
opencode.jsonc (the old one is kept as opencode.jsonc.bak). --agents picks
which agents to set up.

{user} in --config/--prefix/--codex-home is the roster's user; "~{user}" is
that account's home. Newly issued keys are written to --output: the input
roster with the litellm_key cells filled in (nothing else changes; neither
the input nor an existing output file is overwritten). The output is written
as the invoking user, so it can go on gocryptfs.

--sudo reruns as root (inputs read as the invoking user first). Issuing keys
stays in root; everything that reads or writes a user's home (auth.json,
config files) runs in a child with that user's uid, so links the user planted
can't make root read or write other files. Without --sudo nothing changes
owner. Nothing is deleted.
Settings: agent_setup.env (LITELLM_API_KEY, needed only to issue keys).
"""

import argparse
import csv
import io
import json
import os
import pwd
import stat
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "enroll"))
from litellm_admin import ApiError, LiteLLM, as_user, parse_env, read_roster, rerun_as_root, split_set  # noqa: E402

KEY_COLUMN = "litellm_key"
AGENTS = ("opencode", "codex")


class Skip(Exception):
    """Step not applicable to this row; reported, not an error."""


def world_readable(path):
    """True if others can reach and read path (needed for a symlink target)."""
    path = os.path.abspath(path)
    if not os.stat(path).st_mode & stat.S_IROTH:
        return False
    d = os.path.dirname(path)
    while True:
        if not os.stat(d).st_mode & stat.S_IXOTH:
            return False
        if d == "/":
            return True
        d = os.path.dirname(d)


def expand(template, user):
    """'{user}' -> user, then '~name' -> name's home. KeyError if that account doesn't exist."""
    path = os.path.expanduser(template.replace("{user}", user))
    if path.startswith("~"):
        raise KeyError(user)
    return path


class Target:
    """Paths for one user. pw is set when running as root: the steps then run
    as that user (as_user), so what they create is the user's already."""

    def __init__(self, user, opts):
        self.user = user
        self.oc_config = os.path.join(expand(opts.config, user), "opencode", "opencode.jsonc")
        self.oc_auth = os.path.join(expand(opts.prefix, user), "share", "opencode", "auth.json")
        codex_home = expand(opts.codex_home, user)
        self.codex_config = os.path.join(codex_home, "config.toml")
        self.codex_auth = os.path.join(codex_home, "auth.json")
        self.pw = None
        if os.geteuid() == 0:
            try:
                self.pw = pwd.getpwnam(user)
            except KeyError:
                pass
        self.dir_mode = opts.dir_mode

    def makedirs(self, d):
        """Create missing parents of d with dir_mode."""
        missing = []
        while not os.path.isdir(d):
            missing.append(d)
            d = os.path.dirname(d)
        for d in reversed(missing):
            os.mkdir(d, self.dir_mode)
            os.chmod(d, self.dir_mode)

    def write_json(self, path, data):
        """Write 0600 JSON atomically."""
        d = os.path.dirname(path)
        self.makedirs(d)
        fd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")   # 0600
        try:
            with os.fdopen(fd, "w") as fp:
                json.dump(data, fp, indent=2)
                fp.write("\n")
            os.replace(tmp, path)
        except BaseException:
            os.unlink(tmp)
            raise


def ensure_oc_auth(t, key, opts):
    """Set the provider entry in OpenCode's auth.json, keeping the other entries."""
    entry = {"type": "api", "key": key}
    data = {}
    if os.path.exists(t.oc_auth):
        with open(t.oc_auth, encoding="utf-8") as fp:
            data = json.load(fp)
        if data.get(opts.provider_id) == entry:
            return "exists"
    result = "updated" if opts.provider_id in data else "created"
    if not opts.dry_run and key is not None:
        data[opts.provider_id] = entry
        t.write_json(t.oc_auth, data)
    return result


def ensure_codex_auth(t, key, opts):
    """Codex's auth.json holds a single login: create it, never replace it."""
    entry = {"auth_mode": "apikey", "OPENAI_API_KEY": key}
    if os.path.exists(t.codex_auth):
        with open(t.codex_auth, encoding="utf-8") as fp:
            data = json.load(fp)
        if data.get("OPENAI_API_KEY") == key and key is not None:
            return "exists"
        if data.get("auth_mode") == "apikey":
            raise Skip(f"{t.codex_auth} has a different API key; left alone")
        raise Skip(f"{t.codex_auth} has another login (auth_mode={data.get('auth_mode')}); left alone")
    if not opts.dry_run and key is not None:
        t.write_json(t.codex_auth, entry)
    return "created"


def same_content(path, content):
    with open(path, "rb") as fp:
        return fp.read() == content


def ensure_config(t, src, content, dest, opts, mode="copy", force=False):
    """Install src at dest: a symlink to src, or a copy of content (src's bytes,
    read by the caller: the user may not be able to read src). An existing
    different dest is left alone, or with force moved to dest.bak."""
    src = os.path.abspath(src)
    if mode == "symlink":
        if os.path.islink(dest) and os.readlink(dest) == src:
            return "exists"
    elif os.path.isfile(dest) and not os.path.islink(dest) and same_content(dest, content):
        return "exists"
    result = "created"
    if os.path.lexists(dest):
        if not force:
            raise Skip(f"{dest} exists and differs; left alone")
        result = "replaced"
        if not opts.dry_run:
            os.replace(dest, dest + ".bak")
    if opts.dry_run:
        return result
    t.makedirs(os.path.dirname(dest))
    if mode == "symlink":
        os.symlink(src, dest)
    else:
        fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(fd, "wb") as fp:
            fp.write(content)
        os.chmod(dest, 0o644)
    return result


def needs_key(rows):
    return [r for r in rows if not r["key"] and r["litellm_user"]]


def write_output(fp, roster_text, issued):
    """The input roster with litellm_key filled in for issued users."""
    reader = csv.DictReader(io.StringIO(roster_text))
    fields = list(reader.fieldnames or [])
    if KEY_COLUMN not in fields:
        fields.append(KEY_COLUMN)
    w = csv.DictWriter(fp, fieldnames=fields, lineterminator="\n")
    w.writeheader()
    for r in reader:
        user = (r.get("user") or "").strip()
        if user in issued and not (r.get(KEY_COLUMN) or "").strip():
            r[KEY_COLUMN] = issued[user]
        w.writerow(r)


def run(opts, roster_text, env_text, log, emit):
    """Process the roster. log(str) reports; emit(user, key) records a new key."""
    env = parse_env(env_text)
    url = opts.litellm_server or env.get("LITELLM_URL", "http://127.0.0.1:4000")
    budget = env.get("LITELLM_KEY_MAX_BUDGET")
    agents = split_set(opts.agents) or set(AGENTS)
    conn = []

    def litellm():
        """Connect only when a key has to be issued."""
        if not conn:
            if "LITELLM_API_KEY" not in env:
                raise ApiError(f"LITELLM_API_KEY is not set in {opts.env}")
            conn.append(LiteLLM(url, env["LITELLM_API_KEY"], opts.dry_run,
                                env.get("LITELLM_KEY_DURATION") or None,
                                float(budget) if budget else None, issuer="agent_setup"))
        return conn[0]

    rows, problems = read_roster(roster_text, split_set(opts.user), split_set(opts.klass))
    prefix = "[dry-run] " if opts.dry_run else ""
    # Read the templates here: the users may not be able to read them
    templates = {}
    for name, path in (("opencode", opts.opencode_config), ("codex", opts.codex_config)):
        if name in agents:
            with open(path, "rb") as fp:
                templates[name] = fp.read()
    step_names = ["key"]
    if "opencode" in agents:
        step_names += ["oc_auth", "oc_config"]
    if "codex" in agents:
        step_names += ["codex_auth", "codex_config"]
    counts = {}
    for row in rows:
        user = row["user"]
        if not row["key"] and not row["litellm_user"]:
            problems.append((user, "no litellm_key or litellm_user; skipped"))
            continue
        try:
            t = Target(user, opts)
        except KeyError:
            problems.append((user, "no such account on this host"))
            continue
        done, key = [], row["key"]

        def step_key():
            nonlocal key
            if key:
                return "given"
            alias = f"{user}@{opts.site}" if opts.site else user
            key, note = litellm().issue_key(alias, row["litellm_user"], row["team"])
            if key:
                emit(user, key)
            return "issued" + note

        def in_home(fn):
            """Run a step that touches the user's home as that user when we are root."""
            if t.pw is None:
                return fn
            return lambda: as_user(t.pw, fn, (Skip, ValueError))

        def with_key(fn):
            def step():
                # on a dry run a key that would be issued is still None
                if not key and not opts.dry_run:
                    raise Skip("no key")
                return in_home(lambda: fn(t, key, opts))()
            return step

        steps = {"key": step_key,
                 "oc_auth": with_key(ensure_oc_auth),
                 "oc_config": in_home(lambda: ensure_config(
                     t, opts.opencode_config, templates.get("opencode"), t.oc_config, opts,
                     mode=opts.opencode_config_mode, force=opts.force_opencode_jsonc)),
                 "codex_auth": with_key(ensure_codex_auth),
                 "codex_config": in_home(lambda: ensure_config(
                     t, opts.codex_config, templates.get("codex"), t.codex_config, opts))}
        for step in step_names:
            try:
                result = steps[step]()
            except Skip as e:
                result = "skipped"
                problems.append((user, f"{step}: {e}"))
            except (ApiError, OSError, ValueError) as e:
                result = "error"
                problems.append((user, f"{step}: {e}"))
            k = (step, result.split()[0])
            counts[k] = counts.get(k, 0) + 1
            done.append(f"{step}:{result}")
        log(f"{prefix}{user:10s} " + "  ".join(done))

    log("")
    log(f"{prefix}summary ({len(rows)} rows)")
    for step in step_names:
        log(f"  {step:12s} " + ", ".join(f"{r}={n}" for (s, r), n in sorted(counts.items()) if s == step))
    if problems:
        log("")
        log(f"{prefix}skipped / errors ({len(problems)})")
        for user, msg in problems:
            log(f"  {user:10s} {msg}")
    return 1 if any(r == "error" for (_, r) in counts) else 0


def root_args(opts):
    """Options for the root side of --sudo (-o is handled by the invoking user)."""
    args = ["--config", opts.config, "--prefix", opts.prefix, "--codex-home", opts.codex_home,
            "--opencode-config", os.path.abspath(opts.opencode_config),
            "--codex-config", os.path.abspath(opts.codex_config),
            "--opencode-config-mode", opts.opencode_config_mode, "--provider-id", opts.provider_id,
            "--site", opts.site, "--env", opts.env, "--dir-mode", oct(opts.dir_mode)[2:]]
    for flag, val in (("--litellm-server", opts.litellm_server), ("--agents", opts.agents),
                      ("--user", opts.user), ("--class", opts.klass)):
        if val:
            args += [flag, val]
    if opts.dry_run:
        args.append("--dry-run")
    if opts.force_opencode_jsonc:
        args.append("--force-opencode-jsonc")
    return args


def main():
    ap = argparse.ArgumentParser(description="Set up OpenCode / Codex CLI with a LiteLLM key for a roster")
    ap.add_argument("roster", nargs="?", help="roster csv (user, litellm_user, litellm_key, litellm_team, class)")
    ap.add_argument("-o", "--output", help="write the roster with newly issued keys here (required if keys are issued)")
    ap.add_argument("--agents", help=f"comma-separated agents to set up (default: {','.join(AGENTS)})")
    ap.add_argument("--config", default="~{user}/.config", help="XDG config dir template for OpenCode (default: ~{user}/.config)")
    ap.add_argument("--prefix", default="~{user}/.local", help="data prefix template; OpenCode's auth.json goes in "
                    "PREFIX/share/opencode (default: ~{user}/.local)")
    ap.add_argument("--codex-home", default="~{user}/.codex", help="Codex home template (default: ~{user}/.codex)")
    ap.add_argument("--opencode-config", default=os.path.join(HERE, "opencode.jsonc"),
                    help="opencode.jsonc to install (default: the one next to this script)")
    ap.add_argument("--codex-config", default=os.path.join(HERE, "codex.toml"),
                    help="Codex config.toml to install (default: codex.toml next to this script)")
    ap.add_argument("--opencode-config-mode", choices=["copy", "symlink"], default="copy",
                    help="install opencode.jsonc as a copy or a symlink to --opencode-config (default: copy); "
                    "Codex's config.toml is always copied")
    ap.add_argument("--force-opencode-jsonc", action="store_true",
                    help="replace an existing, different opencode.jsonc (old one kept as .bak)")
    ap.add_argument("--provider-id", default="litellm", help="provider id in opencode.jsonc (default: litellm)")
    ap.add_argument("--site", default="", help="key alias suffix: user@site (default: alias = user)")
    ap.add_argument("--litellm-server", help="LiteLLM admin API URL (default: LITELLM_URL or http://127.0.0.1:4000)")
    ap.add_argument("--env", default=os.path.join(HERE, "agent_setup.env"),
                    help="settings file with LITELLM_API_KEY (default: agent_setup.env)")
    ap.add_argument("--dir-mode", type=lambda s: int(s, 8), default=0o700, help="mode of created directories (default: 0700)")
    ap.add_argument("--user", help="comma-separated users to process")
    ap.add_argument("--class", dest="klass", help="comma-separated classes (class column) to process")
    ap.add_argument("--dry-run", action="store_true", help="show what would be done without changing anything")
    ap.add_argument("--sudo", action="store_true", help="rerun as root and chown what is created")
    ap.add_argument("--stdin", action="store_true", help=argparse.SUPPRESS)  # internal: inputs on stdin
    opts = ap.parse_args()

    unknown = (split_set(opts.agents) or set()) - set(AGENTS)
    if unknown:
        ap.error(f"unknown agents: {', '.join(sorted(unknown))} (choose from {', '.join(AGENTS)})")

    if opts.stdin:
        # root side of --sudo: log to stderr, report each new key on stdout at once
        payload = json.load(sys.stdin)

        def emit(user, key):
            print(json.dumps({"user": user, "key": key}), flush=True)
        return run(opts, payload["roster"], payload.get("env", ""),
                   lambda s: print(s, file=sys.stderr, flush=True), emit)

    if not opts.roster:
        ap.error("roster is required")
    if opts.opencode_config_mode == "symlink" and not world_readable(opts.opencode_config):
        ap.error(f"{opts.opencode_config} is not readable by others; users can't follow a symlink to it. "
                 "Put it in a shared place (e.g. /home/share/jupyter_tools/agents/opencode.jsonc) "
                 "or use --opencode-config-mode copy")
    with open(opts.roster, encoding="utf-8") as fp:
        roster_text = fp.read()
    env_text = open(opts.env, encoding="utf-8").read() if os.path.exists(opts.env) else ""

    # Create the output first, so a key is never issued without a place to save it.
    out = None
    rows, _ = read_roster(roster_text, split_set(opts.user), split_set(opts.klass))
    if not opts.dry_run and needs_key(rows):
        if not opts.output:
            ap.error(f"{len(needs_key(rows))} keys would be issued; give -o/--output to save them")
        try:
            out = open(opts.output, "x", encoding="utf-8")   # never overwrite
        except FileExistsError:
            ap.error(f"{opts.output} already exists; give a new file name")
        os.chmod(opts.output, 0o600)

    issued = {}
    try:
        if opts.sudo and os.geteuid() != 0:
            files = {"roster": opts.roster}
            if os.path.exists(opts.env):
                files["env"] = opts.env
            rc, stdout = rerun_as_root(__file__, files, root_args(opts), capture=True)
            for line in stdout.splitlines():
                d = json.loads(line)
                issued[d["user"]] = d["key"]
        else:
            rc = run(opts, roster_text, env_text, print, lambda u, k: issued.__setitem__(u, k))
    finally:
        if out:
            if issued:
                write_output(out, roster_text, issued)
                out.close()
                print(f"\n{len(issued)} new keys written to {opts.output}")
            else:
                out.close()
                os.unlink(opts.output)
    return rc


if __name__ == "__main__":
    sys.exit(main())
