// OpenCode -> LiteLLM
//
// Install as ~/.config/opencode/opencode.jsonc (agent_setup does this).
// No key here: opencode takes it from ~/.local/share/opencode/auth.json, entry "litellm"
// (written by agent_setup, or by "opencode auth login" -> Other -> litellm).
//
// models のキーは LiteLLM の config.yaml の model_name と完全一致させること。
// 片方だけ変えると OpenCode 側から見えなくなる。
// name は表示用のラベルなので自由。
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "name": "LiteLLM (taulec)",
      "options": {
        "baseURL": "https://taulec.zapto.org/litellm/v1"
      },
      "models": {
        "llm-jp-4.1-32b-a3b-thinking": {
	   "name": "LLM-jp-4.1 32b-a3b-thinking (LLM-jp)",
           "povider": { "npm": "@ai-sdk/openai" }
        },
        "llm-jp-4.1-33b-thinking": {
	   "name": "LLM-jp-4.1 33b-thinking (LLM-jp)",
           "povider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-oss-20b-mdx-maas": {
          "name": "gpt-oss-20b (mdx MaaS)",
          "provider": { "npm": "@ai-sdk/openai-compatible" }
        },
        "llm-jp/llm-jp-4-32b-a3b-thinking": {
          "name": "LLM-jp-4 32b-a3b-thinking (mdx MaaS)",
          "provider": { "npm": "@ai-sdk/openai-compatible" }
        },
        "llm-jp/llm-jp-4-8b-thinking": {
          "name": "LLM-jp-4 8b-thinking (mdx MaaS)",
          "provider": { "npm": "@ai-sdk/openai-compatible" }
        },
        "gpt-5.3-codex-utokyo-azure": {
          "name": "GPT-5.3 Codex (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "Kimi-K2.7-Code-utokyo-azure": {
          "name": "Kimi-K2.7-Code-utokyo-azure (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-6-astra-utokyo-azure": {
          "name": "GPT-6 Astra (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-6-luna-utokyo-azure": {
          "name": "GPT-6 Luna (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-6-sol-utokyo-azure": {
          "name": "GPT-6 Sol (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-5.6-luna-utokyo-azure": {
          "name": "GPT-5.6 Luna (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-5.6-terra-utokyo-azure": {
          "name": "GPT-5.6 Terra (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
        "gpt-5.6-sol-utokyo-azure": {
          "name": "GPT-5.6 Sol (UTokyo Azure)",
          "provider": { "npm": "@ai-sdk/openai" }
        },
      }
    }
  },
  "model": "litellm/llm-jp-4.1-32b-a3b-thinking"
}
