#!/bin/bash
# Set up OpenCode -> LiteLLM for yourself (e.g. on your laptop). Idempotent.
# The key goes in auth.json via "opencode auth login"; see README.md.
set -eu
cd "$(dirname "$0")"
HERE=$(pwd)

command -v opencode >/dev/null || {
    echo "opencode がありません。先に導入してください:" >&2
    echo "  npm i -g opencode-ai        # あるいは https://opencode.ai の手順" >&2
    exit 1; }

mkdir -p ~/.config/opencode
DEST=~/.config/opencode/opencode.jsonc
if [ -e "$DEST" ] && [ ! -L "$DEST" ]; then
    echo "$DEST が実ファイルとして存在します。退避します -> $DEST.bak"
    mv "$DEST" "$DEST.bak"
fi
ln -sfn "$HERE/opencode.jsonc" "$DEST"
echo "symlink: $DEST -> $HERE/opencode.jsonc"

echo
echo "次に鍵を登録してください (LMS で受け取った virtual key):"
echo "  opencode auth login     # Other → provider id に litellm → 鍵を貼る"
echo "起動: opencode"
