#!/bin/bash
# LiteLLM 用の PostgreSQL を用意する (Ubuntu, native)
#
#   ./setup_postgres
#
# litellm.env の DATABASE_URL からユーザ名・パスワード・DB 名を読み取り、
# 同じものを PostgreSQL 側に作る。sudo のパスワードを聞かれる。
# 冪等: すでに存在する場合はパスワードだけ設定し直す。

set -eu
cd "$(dirname "$0")"
. ./litellm.env

# postgresql://USER:PASS@HOST:PORT/DB
proto_removed=${DATABASE_URL#postgresql://}
creds=${proto_removed%%@*}
hostpart=${proto_removed#*@}
DB_USER=${creds%%:*}
DB_PASS=${creds#*:}
DB_NAME=${hostpart#*/}

echo "user=$DB_USER db=$DB_NAME"

if ! command -v psql >/dev/null; then
    echo "--- PostgreSQL を導入"
    sudo apt-get update
    sudo apt-get install -y postgresql
fi

sudo systemctl enable --now postgresql

echo "--- ロールと DB を作成"
sudo -u postgres psql -v ON_ERROR_STOP=1 <<SQL
DO \$\$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$DB_USER') THEN
        CREATE ROLE $DB_USER LOGIN PASSWORD '$DB_PASS';
    ELSE
        ALTER ROLE $DB_USER LOGIN PASSWORD '$DB_PASS';
    END IF;
END
\$\$;
SELECT 'CREATE DATABASE $DB_NAME OWNER $DB_USER'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '$DB_NAME')\gexec
SQL

echo "--- 疎通確認"
PGPASSWORD=$DB_PASS psql -h 127.0.0.1 -U "$DB_USER" -d "$DB_NAME" -c 'select version();' >/dev/null \
    && echo "OK: LiteLLM から接続できる状態になりました"
