# LiteLLM のホスト固有設定と秘密情報
# cp litellm.env.example litellm.env && chmod 600 litellm.env  してから埋める。
# litellm.env はコミットしない (.gitignore 済み)。

# --- 上流プロバイダのキー (config.yaml が os.environ/NAME で参照する) ---
# UTokyo Azure (tau-lecture-ai)
export OPENAI_API_KEY=
# mdx MaaS
export MDX_MAAS_API_KEY=

# --- プロキシ自体の管理者キー。学生には絶対に渡さない ---
# 全学生の鍵を発行・閲覧できる。生成:
#   python3 -c 'import secrets;print("sk-"+secrets.token_urlsafe(32))'
export LITELLM_MASTER_KEY=

# --- virtual key と利用実績を保存する PostgreSQL ---
# ロールと DB は ansible (roles/litellm) が作る。ユーザ名・パスワード・DB 名は
# ansible/vars/litellm.yml の litellm_db_user / litellm_db_password / litellm_db_name と揃える:
#   postgresql://<litellm_db_user>:<litellm_db_password>@127.0.0.1:5432/<litellm_db_name>
export DATABASE_URL=postgresql://litellm:<password>@127.0.0.1:5432/litellm

# --- 待ち受け。外に晒さない。公開は Apache が /litellm/v1/ だけ中継する ---
export BIND_HOST=127.0.0.1
export BIND_PORT=4000
