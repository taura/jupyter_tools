#!/bin/bash
# LiteLLM をこのホストに設置する。冪等なので何度でも流し直してよい。
#
#   ./install            # 全部
#   ./install deps       # uv sync + prisma generate だけ
#   ./install db         # PostgreSQL (sudo が要る)
#   ./install service    # systemd user service の登録
#   ./install apache     # Apache の vhost 設定 (sudo が要る)
set -eu
cd "$(dirname "$0")"
HERE=$(pwd)

need_env() {
    if [ ! -f litellm.env ]; then
        echo "litellm.env がありません。" >&2
        echo "  cp litellm.env.example litellm.env && chmod 600 litellm.env" >&2
        echo "して値を埋めてから実行してください。" >&2
        exit 1
    fi
}

do_deps() {
    command -v uv >/dev/null || {
        echo "uv がありません: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2; exit 1; }
    uv sync
    # prisma のクライアントとエンジンは .venv の中に生成される。
    # .venv を作り直すたびに必要。スキーマはリポジトリではなくパッケージ内にある。
    SCHEMA=$(uv run python -c 'import litellm_proxy_extras,os;print(os.path.join(os.path.dirname(litellm_proxy_extras.__file__),"schema.prisma"))')
    uv run prisma generate --schema "$SCHEMA"
}

do_db() {
    need_env
    ./setup_postgres
}

do_service() {
    need_env
    mkdir -p ~/.config/systemd/user
    ln -sfn "$HERE/litellm.service" ~/.config/systemd/user/litellm.service
    systemctl --user daemon-reload
    systemctl --user enable --now litellm
    systemctl --user status litellm --no-pager | head -5 || true
    echo
    echo "ホスト起動時に自動で上げるには (未設定なら一度だけ):"
    echo "  sudo loginctl enable-linger $USER"
}

do_apache() {
    sudo cp apache/litellm-subpath.conf /etc/apache2/
    sudo a2enmod proxy proxy_http
    echo
    echo "次を手で行ってください:"
    echo "  sudo \$EDITOR /etc/apache2/sites-available/default-ssl.conf"
    echo "  → <VirtualHost *:443> の中に次の1行を追加"
    echo "      Include /etc/apache2/litellm-subpath.conf"
    echo "  sudo apache2ctl configtest && sudo systemctl reload apache2"
}

case "${1:-all}" in
    deps)    do_deps ;;
    db)      do_db ;;
    service) do_service ;;
    apache)  do_apache ;;
    all)     do_deps; do_db; do_service; do_apache ;;
    *)       echo "usage: $0 [all|deps|db|service|apache]" >&2; exit 1 ;;
esac
