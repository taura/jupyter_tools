#!/bin/bash
# 学生用の Jupyter 環境 (jupyterhub-singleuser, JupyterLab, nbgrader, カーネル) を作る。
# 冪等なので何度でも流し直してよい。sudo は要らない。share で実行する。
#
#   ./install
#
# venv の場所は既定で /home/share/venv/jupyter。JupyterHub (ansible の
# roles/jupyterhub) の jupyterhub_singleuser_venv と揃えること。
#   JUPYTER_VENV=/path/to/venv ./install
#
# 学生全員がこの venv の python を実行するので、venv も uv が入れる Python も
# 全員が読める場所 (share のホーム、755) に置く。
set -eu
cd "$(dirname "$0")"
HERE=$(pwd)
REPO=$(dirname "$HERE")

VENV=${JUPYTER_VENV:-/home/share/venv/jupyter}
# uv が入れる Python 本体。既定 (~/.local/share/uv/python) でも読めはするが、
# venv と並べて置いて「学生から読まれるもの」をひとまとめにする。
PYDIR=$(dirname "$VENV")/python

command -v uv >/dev/null || {
    echo "uv がありません: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2; exit 1; }

# 以前の pip (python -m venv) で作った venv が残っていると混乱のもとなので止める。
# uv が作った venv の pyvenv.cfg には "uv = <version>" の行がある。
if [ -e "$VENV" ] && ! grep -q '^uv = ' "$VENV/pyvenv.cfg" 2>/dev/null; then
    echo "$VENV は uv で作った venv ではありません (以前の pip の venv?)。" >&2
    echo "中身を確認してから消して、もう一度実行してください:" >&2
    echo "  rm -rf $VENV" >&2
    exit 1
fi

umask 022
mkdir -p "$(dirname "$VENV")"
export UV_PROJECT_ENVIRONMENT="$VENV"
export UV_PYTHON_INSTALL_DIR="$PYDIR"
uv sync --frozen

# カーネルを venv の中 (share/jupyter/kernels) に登録する。
# python3 (ipykernel) は ipykernel が自分で置く。
"$VENV/bin/python" -m bash_kernel.install --sys-prefix
"$VENV/bin/python" -m sos_notebook.install --sys-prefix

# nbgrader の学生用の共通設定 (../nbgrader/README.md)。
# venv の etc/jupyter はすべての学生の設定探索パスに入る。
mkdir -p "$VENV/etc/jupyter"
ln -sfn "$REPO/nbgrader/common/nbgrader_config.py" "$VENV/etc/jupyter/nbgrader_config.py"

# 念のため全員が読めるようにする (umask の違う環境で作られた場合など)
chmod -R a+rX "$VENV" "$PYDIR"

echo
"$VENV/bin/jupyter" kernelspec list
echo
echo "OK: $VENV"
echo "JupyterHub を再起動すると、新しく起動する学生のサーバからこの環境が使われます。"
