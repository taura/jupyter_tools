#!/bin/bash
# Mount your Miyabi directory /work/gt81/share/home/<Miyabi user> on ~/miyabi
# with sshfs, riding on your "ssh miyabig" login (ControlMaster). Without one,
# log in first (verification code); ControlPersist keeps that login alive.
#
#   mount-miyabi        mount (then check the targets of ~/notebooks/* links)
#   mount-miyabi -u     unmount
#   mount-miyabi -s     show status
#
# The directories on Miyabi are made by the instructor beforehand (owned by the
# instructor, opened to the student by an ACL); nothing is created here.
#
# Installed as /usr/local/bin/mount-miyabi (ansible roles/jupyterhub).
set -u

HOST=miyabig
MNT=$HOME/miyabi
REMOTE_BASE=/work/gt81/share/home
# Never authenticate by ourselves: use the existing master or fail at once
SSH="ssh -o BatchMode=yes -o ControlMaster=no"

die() { echo "mount-miyabi: $*" >&2; exit 1; }

have_master() { ssh -O check "$HOST" >/dev/null 2>&1; }

# Mounted and answering (a dead sshfs leaves "Transport endpoint is not connected")
mounted_ok() { mountpoint -q "$MNT" && timeout 10 stat -t "$MNT/." >/dev/null 2>&1; }

# Unmount, or say which of your programs keep it busy (current directory or
# an open file in it) and fail
unmount() {
    fusermount3 -u "$MNT" 2>/dev/null && return 0
    echo "mount-miyabi: cannot unmount $MNT: it is in use by" >&2
    for p in /proc/[0-9]*; do
        [ -O "$p" ] || continue
        if readlink "$p/cwd" "$p"/fd/* 2>/dev/null | grep -q "^$MNT\(/\|\$\)"; then
            printf '  %s %s\n' "${p#/proc/}" "$(tr '\0' ' ' < "$p/cmdline" | cut -c1-100)" >&2
        fi
    done
    echo "Close them (or cd out of $MNT in terminals) and try again." >&2
    exit 1
}

# A key on taulec (made with ssh-keygen here), or one in a forwarded agent
have_key() {
    ls ~/.ssh/id_* 2>/dev/null | grep -qv '\.pub$' || ssh-add -l >/dev/null 2>&1
}

no_key() {
    cat >&2 <<EOF
mount-miyabi: you have no SSH key for Miyabi here yet.
  1. Create one (set a passphrase; do not leave it empty):
       ssh-keygen -t ed25519
  2. Register the public key on the Miyabi portal; this prints it:
       cat ~/.ssh/id_ed25519.pub
  3. Run mount-miyabi again.
EOF
    exit 1
}

# Log in to Miyabi; the login stays as the master (ControlMaster auto + ControlPersist)
login() {
    have_key || no_key
    echo "Logging in to Miyabi ($HOST): enter your key's passphrase and the verification code."
    if ! ssh -o ControlMaster=auto "$HOST" true || ! have_master; then
        cat >&2 <<EOF
mount-miyabi: could not log in to Miyabi.
  Check that your public key (~/.ssh/id_ed25519.pub) is registered on the
  Miyabi portal, and that the passphrase and the verification code are right.
EOF
        exit 1
    fi
}

case "${1:-}" in
-u)
    mountpoint -q "$MNT" || { echo "Not mounted: $MNT"; exit 0; }
    unmount
    echo "Unmounted $MNT"
    exit 0 ;;
-s)
    if have_master; then echo "Miyabi login: yes"; else echo "Miyabi login: no (mount-miyabi will ask for it)"; fi
    if mounted_ok; then echo "Mount: $MNT (OK)"
    elif mountpoint -q "$MNT"; then echo "Mount: $MNT (not responding; run mount-miyabi -u, then mount-miyabi)"
    else echo "Mount: none"; fi
    exit 0 ;;
"") ;;
*) die "usage: mount-miyabi [-u|-s]" ;;
esac

[ -d "$MNT" ] || die "$MNT does not exist (not enrolled in a Miyabi class?); ask your instructor"

# Log in first: the Miyabi G kernel needs only this, and a mount left dead by a
# lost login may come back by itself (sshfs -o reconnect) once it is there
have_master || login

if mounted_ok; then
    echo "Already mounted: $MNT"
else
    if mountpoint -q "$MNT"; then
        # leftover of a dead sshfs (e.g. the Miyabi login ended)
        unmount
    fi
    MUSER=$(ssh -G "$HOST" | awk '$1 == "user" { print $2 }')
    [ -n "$MUSER" ] || die "no User for Host $HOST in ~/.ssh/config"
    REMOTE=$REMOTE_BASE/$MUSER
    # made by the instructor beforehand
    $SSH "$HOST" "test -d $REMOTE" \
        || die "your directory on Miyabi ($REMOTE) does not exist; ask your instructor"
    sshfs "$HOST:$REMOTE" "$MNT" -o ssh_command="$SSH" -o reconnect -o idmap=user \
        || die "sshfs failed"
    mounted_ok || die "mounted, but $MNT does not respond"
    echo "Mounted $MNT -> Miyabi:$REMOTE"
fi

# ~/notebooks/<course> -> ~/miyabi/... links (made by enroll) need their targets
for link in "$HOME"/notebooks/*; do
    [ -L "$link" ] || continue
    target=$(realpath -m "$link")
    case $target in
    "$MNT"/*)
        if [ ! -d "$target" ]; then
            echo "mount-miyabi: warning: $target does not exist on Miyabi, so" >&2
            echo "  $link cannot be used; ask your instructor" >&2
        fi ;;
    esac
done
