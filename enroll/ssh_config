# Miyabi (added by enroll; edit freely)
#   ssh-keygen -t ed25519   # once, with a passphrase; register ~/.ssh/id_ed25519.pub
#                           # on the Miyabi portal
#   mount-miyabi            # log in (passphrase + verification code), mount ~/miyabi
# The Miyabi G kernel in Jupyter, sshfs and later "ssh miyabig" ride on this
# login (ControlMaster); it lives on for ControlPersist after the last session
# closes.
Host miyabig
    HostName miyabi-g.jcahpc.jp
    User {miyabi}
    ControlMaster auto
    ControlPath ~/.ssh/cm_%r@%h:%p
    ControlPersist 6h
    ServerAliveInterval 60

Host miyabic
    HostName miyabi-c.jcahpc.jp
    User {miyabi}
    ControlMaster auto
    ControlPath ~/.ssh/cm_%r@%h:%p
    ControlPersist 6h
    ServerAliveInterval 60
