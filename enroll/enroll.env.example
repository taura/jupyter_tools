# Settings for ./enroll. Copy to enroll.env (chmod 600); enroll.env is not committed.
# Values shown are the defaults unless marked "required".

# Open WebUI admin API key (required).
# Admin Panel -> Settings -> General: enable API keys; then Settings -> Account -> API keys.
OPENWEBUI_API_KEY=sk-...
#OPENWEBUI_URL=http://127.0.0.1:8080

# LiteLLM admin key that can create teams and keys (required).
# Preferably a dedicated key (revocable on its own; see README), not a copy of the master key.
LITELLM_API_KEY=sk-...
#LITELLM_URL=http://127.0.0.1:4000
# Optional per-key limits (default: none; the team's limits apply)
#LITELLM_KEY_DURATION=180d
#LITELLM_KEY_MAX_BUDGET=20

# JupyterHub user_map (roles/jupyterhub)
#USER_MAP_DB=/var/lib/jupyterhub/user_map.sqlite
#USER_MAP_PY=/opt/jupyterhub/user_map.py

# Only emails in this domain are enrolled (same as JupyterHub hosted_domain)
#GOOGLE_DOMAIN=g.ecc.u-tokyo.ac.jp

# Created in each user's home
#NOTEBOOKS_DIR=notebooks
#KEY_FILE=.litellm_key
